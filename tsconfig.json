{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true, "skipLibCheck": true,
    "allowJs": true, "checkJs": false, "noEmit": true, "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src", "components", "lib/*.d.mts"]
}
